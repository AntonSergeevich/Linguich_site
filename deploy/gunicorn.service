; systemd-юнит для приложения. Копировать в /etc/systemd/system/linguich.service
;   sudo cp deploy/gunicorn.service /etc/systemd/system/linguich.service
;   sudo systemctl daemon-reload && sudo systemctl enable --now linguich

[Unit]
Description=Linguich (Django + gunicorn)
After=network.target
; Раскомментировать, если база — PostgreSQL на этом же сервере:
; Requires=postgresql.service
; After=postgresql.service

[Service]
Type=notify
User=linguich
Group=www-data
WorkingDirectory=/srv/linguich
EnvironmentFile=/srv/linguich/.env

; Слушаем unix-сокет, а не порт: nginx рядом, лишний TCP-хоп не нужен,
; и приложение недоступно снаружи в обход nginx.
ExecStart=/srv/linguich/.venv/bin/gunicorn config.wsgi:application \
    --workers 3 \
    --threads 2 \
    --timeout 60 \
    --graceful-timeout 30 \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --bind unix:/run/linguich/gunicorn.sock \
    --access-logfile - \
    --error-logfile -

ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5

; Каталог сокета создаётся systemd при каждом старте.
RuntimeDirectory=linguich
RuntimeDirectoryMode=0750

; Базовая изоляция: приложению нечего делать за пределами своего каталога.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/linguich

[Install]
WantedBy=multi-user.target
