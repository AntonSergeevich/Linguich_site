# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Базовое ---------------------------------------------------------------
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=linguich.ru,www.linguich.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://linguich.ru,https://www.linguich.ru
SITE_URL=https://linguich.ru

# --- База данных -----------------------------------------------------------
# На сервере — PostgreSQL. Пароль пишется как есть, экранировать ничего
# не нужно. Если эти переменные не заданы, локально используется SQLite.
POSTGRES_DB=linguich
POSTGRES_USER=linguich
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Альтернатива для хостингов, которые отдают одну строку подключения.
# Спецсимволы в пароле здесь обязаны быть процентно-закодированы.
# DATABASE_URL=postgres://user:pa%40ss@localhost:5432/linguich

# --- Почта -----------------------------------------------------------------
# Порт задаёт способ шифрования сам: 465 — SSL, 587 — STARTTLS. Переменные
# EMAIL_USE_SSL / EMAIL_USE_TLS нужны, только если хостинг ведёт себя нетипично.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=linguich@yandex.ru
# Для Яндекса это НЕ пароль от почты, а «пароль приложения»:
# id.yandex.ru → Безопасность → Пароли приложений → Почта.
EMAIL_HOST_PASSWORD=
# Адрес обязан совпадать с EMAIL_HOST_USER — иначе Яндекс отклонит письмо.
DEFAULT_FROM_EMAIL=Лингвич <linguich@yandex.ru>

# --- Telegram-бот для напоминаний ------------------------------------------
# Токен уже работающего бота школы. Отправка сообщений через Bot API не мешает
# боту жить своей жизнью — конфликтует только приём апдейтов.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=linguich_bot

# Вариант А (бот школы уже есть): бот сам сообщает нам chat_id ученика,
# вызывая POST /accounts/telegram/link/ с этим ключом в заголовке X-Api-Key.
TELEGRAM_LINK_API_KEY=

# Вариант Б (своего бота нет): апдейты принимает платформа через вебхук.
# Заполнять только если вариант А не используется.
TELEGRAM_WEBHOOK_SECRET=

# Переменной с chat_id здесь нет намеренно: для отправки нужен токен бота
# (он выше) и chat_id ПОЛУЧАТЕЛЯ. Получателей много, поэтому chat_id живёт
# в аккаунте каждого — поле «Telegram ID» в профиле кабинета.

# --- Доступ и защита -------------------------------------------------------
# Свободная регистрация выключена: аккаунт ученику заводит школа, логин
# и пароль генерируются в кабинете. Включать, только если решите вернуть
# самостоятельную запись.
PUBLIC_REGISTRATION_ENABLED=False
# Защита форм заявки от ботов. Выключать только при отладке самих форм.
LEAD_ANTISPAM_ENABLED=True

# --- Правила школы ---------------------------------------------------------
# За сколько минут до урока отправлять напоминания (через запятую).
LESSON_REMINDER_OFFSETS=1440,60
# За сколько часов до урока можно отменить запись без списания занятия.
FREE_CANCELLATION_HOURS=12

LOG_LEVEL=INFO
