# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Базовое ---------------------------------------------------------------
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=linguich.ru,www.linguich.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://linguich.ru,https://www.linguich.ru
SITE_URL=https://linguich.ru

# --- База данных -----------------------------------------------------------
# По умолчанию SQLite (файл db.sqlite3) — этого хватает школе на сотни учеников.
# Для PostgreSQL раскомментируйте:
# DATABASE_URL=postgres://user:password@localhost:5432/linguich

# --- Почта -----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@linguich.ru
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Лингвич <noreply@linguich.ru>

# --- Telegram-бот для напоминаний ------------------------------------------
# Создаётся у @BotFather. Токен и имя бота без «@».
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=linguich_bot
# Секрет для проверки вебхука (передаётся при setWebhook как secret_token)
TELEGRAM_WEBHOOK_SECRET=

# --- Правила школы ---------------------------------------------------------
# За сколько минут до урока отправлять напоминания (через запятую).
LESSON_REMINDER_OFFSETS=1440,60
# За сколько часов до урока можно отменить запись без списания занятия.
FREE_CANCELLATION_HOURS=12

LOG_LEVEL=INFO
